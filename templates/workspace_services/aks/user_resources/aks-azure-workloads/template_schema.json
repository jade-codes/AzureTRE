{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Workloads",
  "description": "Parameters for creating a workload.",
  "required": [
    "workload_category",
    "workload_environment"
  ],
  "properties": {
    "display_name": {
      "type": "string",
      "title": "Display name for the workload",
      "description": "The display name of the workload.",
      "default": "Default Workload",
      "updateable": true
    },
    "description": {
      "type": "string",
      "title": "Description of the workload",
      "description": "Describe what this workload is used for.",
      "default": "I will use this workload for research.",
      "updateable": true
    },
    "overview": {
      "type": "string",
      "title": "Workload Overview",
      "description": "Long form description of the workload, in markdown syntax",
      "default": "This workload provides a containerised environment for running applications and services. It includes automated scaling, monitoring, and security features.",
      "updateable": true
    },
    "workload_category": {
      "type": "string",
      "title": "Workload Category",
      "description": "Select a workload category to create.",
      "enum": [
        "DevSecOps",
        "AI Models - CPU",
        "Knowledge Graph"
      ]
    },
    "workload_environment": {
      "type": "string",
      "title": "Environment",
      "description": "Select the environment for the workload.",
      "enum": [
        "Development",
        "Staging",
        "Production"
      ]
    },
    "node_size": {
      "type": "string",
      "title": "Node Size",
      "updateable": true
    },
    "node_count": {
      "type": "integer",
      "title": "Node Count",
      "updateable": true
    },
    "node_autoscaling_enabled": {
      "type": "boolean",
      "title": "Node Autoscaling Enabled",
      "updateable": true
    },
    "node_autoscaling_min_count": {
      "type": "integer",
      "title": "Node Autoscaling Min Count",
      "updateable": true
    },
    "node_autoscaling_max_count": {
      "type": "integer",
      "title": "Node Autoscaling Max Count",
      "updateable": true
    },
    "workload_environment_type": {
      "type": "string",
      "title": "Environment Type",
      "updateable": true
    },
    "workload_type": {
      "type": "string",
      "title": "Resource Name",
      "updateable": true
    }
  },
  "uiSchema": {
    "node_size": {
      "classNames": "tre-hidden"
    },
    "node_count": {
      "classNames": "tre-hidden"
    },
    "node_autoscaling_enabled": {
      "classNames": "tre-hidden"
    },
    "node_autoscaling_min_count": {
      "classNames": "tre-hidden"
    },
    "node_autoscaling_max_count": {
      "classNames": "tre-hidden"
    },
    "workload_environment_type": {
      "classNames": "tre-hidden"
    },
    "workload_type": {
      "classNames": "tre-hidden"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workload_category": {
            "const": "DevSecOps"
          }
        },
        "required": [
          "workload_category"
        ]
      },
      "then": {
        "properties": {
          "workload_type": {
            "default": "dsop"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_category": {
            "const": "DevSecOps"
          },
          "workload_environment": {
            "const": "Development"
          }
        },
        "required": [
          "workload_category",
          "workload_environment"
        ]
      },
      "then": {
        "properties": {
          "node_size": {
            "default": "Standard_DS2_v2"
          },
          "node_count": {
            "default": 1
          },
          "node_autoscaling_enabled": {
            "default": true
          },
          "node_autoscaling_min_count": {
            "default": 1
          },
          "node_autoscaling_max_count": {
            "default": 3
          },
          "workload_environment_type": {
            "default": "dev"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_category": {
            "const": "DevSecOps"
          },
          "workload_environment": {
            "const": "Staging"
          }
        },
        "required": [
          "workload_category",
          "workload_environment"
        ]
      },
      "then": {
        "properties": {
          "node_size": {
            "default": "Standard_DS3_v2"
          },
          "node_count": {
            "default": 2
          },
          "node_autoscaling_enabled": {
            "default": true
          },
          "node_autoscaling_min_count": {
            "default": 1
          },
          "node_autoscaling_max_count": {
            "default": 5
          },
          "workload_environment_type": {
            "default": "stage"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_category": {
            "const": "DevSecOps"
          },
          "workload_environment": {
            "const": "Production"
          }
        },
        "required": [
          "workload_category",
          "workload_environment"
        ]
      },
      "then": {
        "properties": {
          "node_size": {
            "default": "Standard_DS4_v2"
          },
          "node_count": {
            "default": 3
          },
          "node_autoscaling_enabled": {
            "default": true
          },
          "node_autoscaling_min_count": {
            "default": 2
          },
          "node_autoscaling_max_count": {
            "default": 10
          },
          "workload_environment_type": {
            "default": "prod"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_category": {
            "const": "AI Models - CPU"
          }
        },
        "required": [
          "workload_category"
        ]
      },
      "then": {
        "properties": {
          "workload_type": {
            "default": "ai-cpu"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_category": {
            "const": "AI Models - CPU"
          },
          "workload_environment": {
            "const": "Development"
          }
        },
        "required": [
          "workload_category",
          "workload_environment"
        ]
      },
      "then": {
        "properties": {
          "node_size": {
            "default": "Standard_E32_v5"
          },
          "node_count": {
            "default": 1
          },
          "node_autoscaling_enabled": {
            "default": true
          },
          "node_autoscaling_min_count": {
            "default": 1
          },
          "node_autoscaling_max_count": {
            "default": 2
          },
          "workload_environment_type": {
            "default": "dev"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_category": {
            "const": "AI Models - CPU"
          },
          "workload_environment": {
            "const": "Staging"
          }
        },
        "required": [
          "workload_category",
          "workload_environment"
        ]
      },
      "then": {
        "properties": {
          "node_size": {
            "default": "Standard_E32_v5"
          },
          "node_count": {
            "default": 1
          },
          "node_autoscaling_enabled": {
            "default": true
          },
          "node_autoscaling_min_count": {
            "default": 1
          },
          "node_autoscaling_max_count": {
            "default": 2
          },
          "workload_environment_type": {
            "default": "stage"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_category": {
            "const": "AI Models - CPU"
          },
          "workload_environment": {
            "const": "Production"
          }
        },
        "required": [
          "workload_category",
          "workload_environment"
        ]
      },
      "then": {
        "properties": {
          "node_size": {
            "default": "Standard_E32_v5"
          },
          "node_count": {
            "default": 3
          },
          "node_autoscaling_enabled": {
            "default": true
          },
          "node_autoscaling_min_count": {
            "default": 1
          },
          "node_autoscaling_max_count": {
            "default": 10
          },
          "workload_environment_type": {
            "default": "prod"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_category": {
            "const": "Knowledge Graph"
          }
        },
        "required": [
          "workload_category"
        ]
      },
      "then": {
        "properties": {
          "workload_type": {
            "default": "kg"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_category": {
            "const": "Knowledge Graph"
          },
          "workload_environment": {
            "const": "Development"
          }
        },
        "required": [
          "workload_category",
          "workload_environment"
        ]
      },
      "then": {
        "properties": {
          "node_size": {
            "default": "Standard_D2_v3"
          },
          "node_count": {
            "default": 1
          },
          "node_autoscaling_enabled": {
            "default": true
          },
          "node_autoscaling_min_count": {
            "default": 1
          },
          "node_autoscaling_max_count": {
            "default": 3
          },
          "workload_environment_type": {
            "default": "dev"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_category": {
            "const": "Knowledge Graph"
          },
          "workload_environment": {
            "const": "Staging"
          }
        },
        "required": [
          "workload_category",
          "workload_environment"
        ]
      },
      "then": {
        "properties": {
          "node_size": {
            "default": "Standard_D4_v3"
          },
          "node_count": {
            "default": 2
          },
          "node_autoscaling_enabled": {
            "default": true
          },
          "node_autoscaling_min_count": {
            "default": 1
          },
          "node_autoscaling_max_count": {
            "default": 5
          },
          "workload_environment_type": {
            "default": "stage"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_category": {
            "const": "Knowledge Graph"
          },
          "workload_environment": {
            "const": "Production"
          }
        },
        "required": [
          "workload_category",
          "workload_environment"
        ]
      },
      "then": {
        "properties": {
          "node_size": {
            "default": "Standard_D8_v3"
          },
          "node_count": {
            "default": 3
          },
          "node_autoscaling_enabled": {
            "default": true
          },
          "node_autoscaling_min_count": {
            "default": 2
          },
          "node_autoscaling_max_count": {
            "default": 12
          },
          "workload_environment_type": {
            "default": "prod"
          }
        }
      }
    }
  ]
}
