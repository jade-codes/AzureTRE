{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Platform Workloads",
  "description": "Parameters for creating a workload.",
  "required": ["workload_name"],
  "properties": {
    "display_name": {
      "type": "string",
      "title": "Display name for the workload",
      "description": "The display name of the workload.",
      "default": "My Workload",
      "updateable": true
    },
    "description": {
      "type": "string",
      "title": "Description of the workload",
      "description": "Describe what this workload is used for.",
      "default": "I will use this workload for research.",
      "updateable": true
    },
    "overview": {
      "type": "string",
      "title": "Workload Overview",
      "description": "Long form description of the workload, in markdown syntax",
      "default": "This workload provides a containerised environment for running applications and services. It includes automated scaling, monitoring, and security features.",
      "updateable": true
    },
    "workload_name": {
      "type": "string",
      "title": "Workload Name",
      "description": "Select a workload to create.",
      "enum": ["DevSecOps", "AI Model", "Knowledge Graph"]
    },
    "node_size": {
      "type": "string",
      "title": "Node Size"
    },
    "node_count": {
      "type": "integer",
      "title": "Node Count"
    },
    "node_autoscaling_enabled": {
      "type": "boolean",
      "title": "Node Autoscaling Enabled"
    },
    "node_autoscaling_min_count": {
      "type": "integer",
      "title": "Node Autoscaling Min Count"
    },
    "node_autoscaling_max_count": {
      "type": "integer",
      "title": "Node Autoscaling Max Count"
    },
    "workload_type": {
      "type": "string",
      "title": "Resource Name"
    }
  },
  "uiSchema": {
    "node_size": {
      "classNames": "tre-hidden"
    },
    "node_count": {
      "classNames": "tre-hidden"
    },
    "node_autoscaling_enabled": {
      "classNames": "tre-hidden"
    },
    "node_autoscaling_min_count": {
      "classNames": "tre-hidden"
    },
    "node_autoscaling_max_count": {
      "classNames": "tre-hidden"
    },
    "workload_type": {
      "classNames": "tre-hidden"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "workload_name": { "const": "DevSecOps" } } },
      "then": {
        "properties": {
          "node_size": { "default": "Standard_DS2_v2" },
          "node_count": { "default": 2 },
          "node_autoscaling_enabled": { "default": true },
          "node_autoscaling_min_count": { "default": 1 },
          "node_autoscaling_max_count": { "default": 5 },
          "workload_type": { "default": "dsop" }
        }
      }
    },
    {
      "if": { "properties": { "workload_name": { "const": "AI Models" } } },
      "then": {
        "properties": {
          "node_size": { "default": "Standard_NC6" },
          "node_count": { "default": 3 },
          "node_autoscaling_enabled": { "default": true },
          "node_autoscaling_min_count": { "default": 1 },
          "node_autoscaling_max_count": { "default": 5 },
          "workload_type": { "default": "ai" }
        }
      }
    },
    {
      "if": { "properties": { "workload_name": { "const": "Knowledge Graph" } } },
      "then": {
        "properties": {
          "node_size": { "default": "Standard_D4_v3" },
          "node_count": { "default": 3 },
          "node_autoscaling_enabled": { "default": true },
          "node_autoscaling_min_count": { "default": 1 },
          "node_autoscaling_max_count": { "default": 5 },
          "workload_type": { "default": "kg" }
        }
      }
    }
  ]
}
