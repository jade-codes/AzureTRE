{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Platform Workloads",
  "description": "Parameters for creating a workload.",
  "required": ["workload_name", "workload_environment"],
  "properties": {
    "display_name": {
      "type": "string",
      "title": "Display name for the workload",
      "description": "The display name of the workload.",
      "default": "My Workload",
      "updateable": true
    },
    "description": {
      "type": "string",
      "title": "Description of the workload",
      "description": "Describe what this workload is used for.",
      "default": "I will use this workload for research.",
      "updateable": true
    },
    "overview": {
      "type": "string",
      "title": "Workload Overview",
      "description": "Long form description of the workload, in markdown syntax",
      "default": "This workload provides a containerised environment for running applications and services. It includes automated scaling, monitoring, and security features.",
      "updateable": true
    },
    "workload_name": {
      "type": "string",
      "title": "Workload Name",
      "description": "Select a workload to create.",
      "enum": ["DevSecOps", "AI Model", "Knowledge Graph"]
    },
    "workload_environment": {
      "type": "string",
      "title": "Environment",
      "description": "Select the environment for the workload.",
      "enum": ["Development", "Staging", "Production"]
    },
    "initial_admin_password": {
      "$id":"#/properties/initial_admin_password",
      "type": "string",
      "title": "Initial Admin Password",
      "description": "Password for the initial admin user of the workload.",
      "sensitive": true,
      "updateable": true
    },
    "node_size": {
      "type": "string",
      "title": "Node Size",
      "updateable": true
    },
    "node_count": {
      "type": "integer",
      "title": "Node Count",
      "updateable": true
    },
    "node_autoscaling_enabled": {
      "type": "boolean",
      "title": "Node Autoscaling Enabled",
      "updateable": true
    },
    "node_autoscaling_min_count": {
      "type": "integer",
      "title": "Node Autoscaling Min Count",
      "updateable": true
    },
    "node_autoscaling_max_count": {
      "type": "integer",
      "title": "Node Autoscaling Max Count",
      "updateable": true
    },
    "workload_environment_type": {
      "type": "string",
      "title": "Environment Type",
      "updateable": true
    },
    "workload_type": {
      "type": "string",
      "title": "Resource Name",
      "updateable": true
    }
  },
  "uiSchema": {
    "node_size": {
      "classNames": "tre-hidden"
    },
    "node_count": {
      "classNames": "tre-hidden"
    },
    "node_autoscaling_enabled": {
      "classNames": "tre-hidden"
    },
    "node_autoscaling_min_count": {
      "classNames": "tre-hidden"
    },
    "node_autoscaling_max_count": {
      "classNames": "tre-hidden"
    },
    "workload_environment_type": {
      "classNames": "tre-hidden"
    },
    "workload_type": {
      "classNames": "tre-hidden"
    },
    "initial_admin_password": {
      "ui:widget": "password"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workload_name": { "const": "DevSecOps" },
          "workload_environment": { "const": "Development" }
        },
        "required": ["workload_name", "workload_environment"]
      },
      "then": {
        "properties": {
          "node_size": { "default": "Standard_DS2_v2" },
          "node_count": { "default": 1 },
          "node_autoscaling_enabled": { "default": true },
          "node_autoscaling_min_count": { "default": 1 },
          "node_autoscaling_max_count": { "default": 3 },
          "workload_type": { "default": "dsop" },
          "workload_environment_type": { "default": "dev" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_name": { "const": "DevSecOps" },
          "workload_environment": { "const": "Staging" }
        },
        "required": ["workload_name", "workload_environment"]
      },
      "then": {
        "properties": {
          "node_size": { "default": "Standard_DS3_v2" },
          "node_count": { "default": 2 },
          "node_autoscaling_enabled": { "default": true },
          "node_autoscaling_min_count": { "default": 1 },
          "node_autoscaling_max_count": { "default": 5 },
          "workload_type": { "default": "dsop" },
          "workload_environment_type": { "default": "stage" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_name": { "const": "DevSecOps" },
          "workload_environment": { "const": "Production" }
        },
        "required": ["workload_name", "workload_environment"]
      },
      "then": {
        "properties": {
          "node_size": { "default": "Standard_DS4_v2" },
          "node_count": { "default": 3 },
          "node_autoscaling_enabled": { "default": true },
          "node_autoscaling_min_count": { "default": 2 },
          "node_autoscaling_max_count": { "default": 10 },
          "workload_type": { "default": "dsop" },
          "workload_environment_type": { "default": "prod" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_name": { "const": "AI Model" },
          "workload_environment": { "const": "Development" }
        },
        "required": ["workload_name", "workload_environment"]
      },
      "then": {
        "properties": {
          "node_size": { "default": "Standard_NC4as_T4_v3" },
          "node_count": { "default": 1 },
          "node_autoscaling_enabled": { "default": true },
          "node_autoscaling_min_count": { "default": 1 },
          "node_autoscaling_max_count": { "default": 2 },
          "workload_type": { "default": "ai" },
          "workload_environment_type": { "default": "dev" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_name": { "const": "AI Model" },
          "workload_environment": { "const": "Staging" }
        },
        "required": ["workload_name", "workload_environment"]
      },
      "then": {
        "properties": {
          "node_size": { "default": "Standard_NC6" },
          "node_count": { "default": 2 },
          "node_autoscaling_enabled": { "default": true },
          "node_autoscaling_min_count": { "default": 1 },
          "node_autoscaling_max_count": { "default": 4 },
          "workload_type": { "default": "ai" },
          "workload_environment_type": { "default": "stage" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_name": { "const": "AI Model" },
          "workload_environment": { "const": "Production" }
        },
        "required": ["workload_name", "workload_environment"]
      },
      "then": {
        "properties": {
          "node_size": { "default": "Standard_NC12" },
          "node_count": { "default": 3 },
          "node_autoscaling_enabled": { "default": true },
          "node_autoscaling_min_count": { "default": 2 },
          "node_autoscaling_max_count": { "default": 15 },
          "workload_type": { "default": "ai" },
          "workload_environment_type": { "default": "prod" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_name": { "const": "Knowledge Graph" },
          "workload_environment": { "const": "Development" }
        },
        "required": ["workload_name", "workload_environment"]
      },
      "then": {
        "properties": {
          "node_size": { "default": "Standard_D2_v3" },
          "node_count": { "default": 1 },
          "node_autoscaling_enabled": { "default": true },
          "node_autoscaling_min_count": { "default": 1 },
          "node_autoscaling_max_count": { "default": 3 },
          "workload_type": { "default": "kg" },
          "workload_environment_type": { "default": "dev" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_name": { "const": "Knowledge Graph" },
          "workload_environment": { "const": "Staging" }
        },
        "required": ["workload_name", "workload_environment"]
      },
      "then": {
        "properties": {
          "node_size": { "default": "Standard_D4_v3" },
          "node_count": { "default": 2 },
          "node_autoscaling_enabled": { "default": true },
          "node_autoscaling_min_count": { "default": 1 },
          "node_autoscaling_max_count": { "default": 5 },
          "workload_type": { "default": "kg" },
          "workload_environment_type": { "default": "stage" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload_name": { "const": "Knowledge Graph" },
          "workload_environment": { "const": "Production" }
        },
        "required": ["workload_name", "workload_environment"]
      },
      "then": {
        "properties": {
          "node_size": { "default": "Standard_D8_v3" },
          "node_count": { "default": 3 },
          "node_autoscaling_enabled": { "default": true },
          "node_autoscaling_min_count": { "default": 2 },
          "node_autoscaling_max_count": { "default": 12 },
          "workload_type": { "default": "kg" },
          "workload_environment_type": { "default": "prod" }
        }
      }
    }
  ]
}
