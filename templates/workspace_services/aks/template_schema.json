{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workloads Service",
  "description": "Parameters for deploying the workloads service .",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "title": "Name for the Workloads Service",
      "description": "The name of the workloads service to be displayed to users.",
      "default": "Workloads",
      "updateable": true
    },
    "description": {
      "type": "string",
      "title": "Description of the Workloads Service",
      "description": "Describe what this workloads service does.",
      "default": "A managed service for deploying, scaling, and managing containerised applications and microservices.",
      "updateable": true
    },
    "overview": {
      "type": "string",
      "title": "Workloads Service Overview",
      "description": "Long form description of the workloads service, in markdown syntax",
      "default": "The Workloads Service provides a managed environment for deploying and orchestrating containerised applications. It offers automated scaling, load balancing, and service discovery for your workloads.",
      "updateable": true
    },
    "workspace_owners_group_id": {
      "type": "string",
      "title": "Workspace Owners Group Object ID",
      "description": "The object ID of the Azure AD group that will be granted admin access to the workloads service."
    }
  },
  "required": [
    "workspace_owners_group_id"
  ],
  "uiSchema": {
    "workspace_owners_group_id": {
      "ui:widget": "text"
    }
  },
  "pipeline": {
    "install": [
      {
        "stepId": "main"
      },
      {
        "stepId": "aks-firewall-rules-install",
        "stepTitle": "Add network firewall rules for AKS",
        "resourceTemplateName": "tre-shared-service-firewall",
        "resourceType": "shared-service",
        "resourceAction": "upgrade",
        "properties": [
          {
            "name": "network_rule_collections",
            "type": "array",
            "arraySubstitutionAction": "replace",
            "arrayMatchField": "name",
            "value": {
              "name": "nrc_svc_{{ resource.id }}_aks",
              "action": "Allow",
              "rules": [
                {
                  "name": "AzureAD",
                  "description": "AAD access for authNZ",
                  "source_addresses": "{{ resource.properties.workspace_address_space }}",
                  "destination_addresses": [
                    "AzureActiveDirectory"
                  ],
                  "destination_ports": [
                    "*"
                  ],
                  "protocols": [
                    "TCP"
                  ]
                }
              ]
            }
          },
          {
            "name": "rule_collections",
            "type": "array",
            "arraySubstitutionAction": "replace",
            "arrayMatchField": "name",
            "value": {
              "name": "arc_svc_{{ resource.id }}_aks",
              "action": "Allow",
              "rules": [
                {
                  "name": "AAD CDN",
                  "description": "AAD CDN",
                  "source_addresses": "{{ resource.properties.workspace_address_space }}",
                  "target_fqdns": [
                    "aadcdn.msftauth.net"
                  ],
                  "protocols": [
                    {
                      "port": "443",
                      "type": "Https"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    ],
    "upgrade": [
      {
        "stepId": "main"
      },
      {
        "stepId": "aks-firewall-rules-upgrade",
        "stepTitle": "Add network firewall rules for AKS",
        "resourceTemplateName": "tre-shared-service-firewall",
        "resourceType": "shared-service",
        "resourceAction": "upgrade",
        "properties": [
          {
            "name": "network_rule_collections",
            "type": "array",
            "arraySubstitutionAction": "replace",
            "arrayMatchField": "name",
            "value": {
              "name": "nrc_svc_{{ resource.id }}_aks",
              "action": "Allow",
              "rules": [
                {
                  "name": "AzureAD",
                  "description": "AAD access for authNZ",
                  "source_addresses": "{{ resource.properties.workspace_address_space }}",
                  "destination_addresses": [
                    "AzureActiveDirectory"
                  ],
                  "destination_ports": [
                    "*"
                  ],
                  "protocols": [
                    "TCP"
                  ]
                }
              ]
            }
          },
          {
            "name": "rule_collections",
            "type": "array",
            "arraySubstitutionAction": "replace",
            "arrayMatchField": "name",
            "value": {
              "name": "arc_svc_{{ resource.id }}_aks",
              "action": "Allow",
              "rules": [
                {
                  "name": "AAD CDN",
                  "description": "AAD CDN",
                  "source_addresses": "{{ resource.properties.workspace_address_space }}",
                  "target_fqdns": [
                    "aadcdn.msftauth.net"
                  ],
                  "protocols": [
                    {
                      "port": "443",
                      "type": "Https"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    ],
    "uninstall": [
      {
        "stepId": "main"
      },
      {
        "stepId": "aks-firewall-rules-uninstall",
        "stepTitle": "Remove network firewall rules for AKS",
        "resourceTemplateName": "tre-shared-service-firewall",
        "resourceType": "shared-service",
        "resourceAction": "upgrade",
        "properties": [
          {
            "name": "network_rule_collections",
            "type": "array",
            "arraySubstitutionAction": "remove",
            "arrayMatchField": "name",
            "value": {
              "name": "nrc_svc_{{ resource.id }}_aks"
            }
          },
          {
            "name": "rule_collections",
            "type": "array",
            "arraySubstitutionAction": "remove",
            "arrayMatchField": "name",
            "value": {
              "name": "arc_svc_{{ resource.id }}_aks"
            }
          }
        ]
      }
    ]
  }
}
