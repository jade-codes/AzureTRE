{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AKS Workspace Service",
  "description": "Parameters for deploying an AKS workspace service in Azure TRE.",
  "type": "object",
  "properties": {
    "node_count": {
      "type": "integer",
      "title": "Node Count",
      "description": "Number of nodes in the default node pool.",
      "default": 3
    },
    "node_vm_size": {
      "type": "string",
      "title": "Node VM Size",
      "description": "VM size for the default node pool.",
      "default": "Standard_DS2_v2"
    },
    "workspace_owners_group_id": {
      "type": "string",
      "title": "Workspace Owners Group Object ID",
      "description": "The object ID of the Azure AD group that will be granted admin access to the AKS cluster."
    }
  },
  "required": ["node_count", "node_vm_size", "workspace_owners_group_id"],
  "uiSchema": {
    "node_count": { "ui:widget": "updown" },
    "node_vm_size": { "ui:widget": "text" },
    "workspace_owners_group_id": { "ui:widget": "text" }
  },
  "pipeline": {
    "install": [
      { "stepId": "main" },
      {
        "stepId": "aks-firewall-rules-install",
        "stepTitle": "Add network firewall rules for AKS",
        "resourceTemplateName": "tre-shared-service-firewall",
        "resourceType": "shared-service",
        "resourceAction": "upgrade",
        "properties": [
          {
            "name": "network_rule_collections",
            "type": "array",
            "arraySubstitutionAction": "replace",
            "arrayMatchField": "name",
            "value": {
              "name": "nrc_svc_{{ resource.id }}_aks",
              "action": "Allow",
              "rules": [
                {
                  "name": "AzureAD",
                  "description": "AAD access for authNZ",
                  "source_addresses": "{{ resource.properties.workspace_address_space }}",
                  "destination_addresses": ["AzureActiveDirectory"],
                  "destination_ports": ["*"],
                  "protocols": ["TCP"]
                }
              ]
            }
          },
          {
            "name": "rule_collections",
            "type": "array",
            "arraySubstitutionAction": "replace",
            "arrayMatchField": "name",
            "value": {
              "name": "arc_svc_{{ resource.id }}_aks",
              "action": "Allow",
              "rules": [
                {
                  "name": "AAD CDN",
                  "description": "AAD CDN",
                  "source_addresses": "{{ resource.properties.workspace_address_space }}",
                  "target_fqdns": ["aadcdn.msftauth.net"],
                  "protocols": [ { "port": "443", "type": "Https" } ]
                }
              ]
            }
          }
        ]
      }
    ],
    "upgrade": [
      { "stepId": "main" },
      {
        "stepId": "aks-firewall-rules-upgrade",
        "stepTitle": "Add network firewall rules for AKS",
        "resourceTemplateName": "tre-shared-service-firewall",
        "resourceType": "shared-service",
        "resourceAction": "upgrade",
        "properties": [
          {
            "name": "network_rule_collections",
            "type": "array",
            "arraySubstitutionAction": "replace",
            "arrayMatchField": "name",
            "value": {
              "name": "nrc_svc_{{ resource.id }}_aks",
              "action": "Allow",
              "rules": [
                {
                  "name": "AzureAD",
                  "description": "AAD access for authNZ",
                  "source_addresses": "{{ resource.properties.workspace_address_space }}",
                  "destination_addresses": ["AzureActiveDirectory"],
                  "destination_ports": ["*"],
                  "protocols": ["TCP"]
                }
              ]
            }
          },
          {
            "name": "rule_collections",
            "type": "array",
            "arraySubstitutionAction": "replace",
            "arrayMatchField": "name",
            "value": {
              "name": "arc_svc_{{ resource.id }}_aks",
              "action": "Allow",
              "rules": [
                {
                  "name": "AAD CDN",
                  "description": "AAD CDN",
                  "source_addresses": "{{ resource.properties.workspace_address_space }}",
                  "target_fqdns": ["aadcdn.msftauth.net"],
                  "protocols": [ { "port": "443", "type": "Https" } ]
                }
              ]
            }
          }
        ]
      }
    ],
    "uninstall": [
      { "stepId": "main" },
      {
        "stepId": "aks-firewall-rules-uninstall",
        "stepTitle": "Remove network firewall rules for AKS",
        "resourceTemplateName": "tre-shared-service-firewall",
        "resourceType": "shared-service",
        "resourceAction": "upgrade",
        "properties": [
          {
            "name": "network_rule_collections",
            "type": "array",
            "arraySubstitutionAction": "remove",
            "arrayMatchField": "name",
            "value": { "name": "nrc_svc_{{ resource.id }}_aks" }
          },
          {
            "name": "rule_collections",
            "type": "array",
            "arraySubstitutionAction": "remove",
            "arrayMatchField": "name",
            "value": { "name": "arc_svc_{{ resource.id }}_aks" }
          }
        ]
      }
    ]
  }
}
